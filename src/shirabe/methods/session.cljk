(ns shirabe.methods.session
  "shirabe 調べ — research-session orchestrator (the ReAct loop). ADR-2606131600.

  Chains plan → retrieve → synthesize into one research SESSION and returns a structured,
  content-addressed result. This is the entry the worker route / CLI / fleet heartbeat
  calls. It threads the injected `fetcher` (live web, G1/G7) and `infer` (Murakumo gemma4,
  G2/G7), so the orchestrator itself is pure control-flow — testable end-to-end on fixtures,
  live with the real legs.

  The loop is ReAct-shaped but BOUNDED (G5): plan once, retrieve, synthesize; if the model
  reports the evidence is INSUFFICIENT and the plan still has un-run sub-queries, do ONE more
  retrieve+synthesize round (capped — never an open-ended crawl).

  CONSTITUTIONAL:
    G3 — `research` takes only the question (+ injected legs + injected clock). No identity
      is bound unless a member signs the session downstream (G6, kotoba/session-datoms)."
  (:require [kotoba.bytes :as kbytes] [shirabe.methods.analyze :as analyze]
            [shirabe.methods.retrieve :as retrieve]
            [shirabe.methods.synthesize :as synthesize]))

(def max-rounds 2)   ;; G5 — bounded ReAct: plan + at most one refinement round

(defn- session-id [question started-at]
  (let [md (java.security.MessageDigest/getInstance "SHA-256")
        bs (.digest md (kbytes/utf8-bytes (str question "\u0000" started-at)))]
    (subs (apply str (map #(format "%02x" (bit-and % 0xff)) bs)) 0 16)))

(defn research
  "Run a full research session. `fetcher` (G1 web) + `infer` (G2 gemma4) injected."
  [question fetcher infer started-at]
  (let [p (analyze/plan question)]
    (loop [round 1, evidence [], result nil]
      (let [sub {:question (:question p)
                 :subqueries (vec (take (inc round) (:subqueries p)))}
            ev (retrieve/retrieve sub fetcher started-at)
            res (synthesize/synthesize question ev infer (:lang p) started-at)]
        (if (or (not (:insufficient res)) (>= round max-rounds))
          {:id (session-id question started-at)
           :question question
           :started-at started-at
           :plan p
           :rounds round
           :evidence ev
           :result res}
          (recur (inc round) ev res))))))
